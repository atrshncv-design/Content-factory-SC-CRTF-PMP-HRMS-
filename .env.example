# Шаблон переменных окружения. Скопировать в .env и заполнить реальными значениями.
# Реальный .env НЕ коммитить (см. .gitignore).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_USERS=          # Hermes adapter name (маппинг TELEGRAM_ALLOWED_USER_IDS → TELEGRAM_ALLOWED_USERS)
TELEGRAM_ARCHIVE_CHAT_ID=

# --- ScrapeCreators ---
SCRAPECREATORS_API_KEY=

# --- Creatify ---
CREATIFY_API_ID=
CREATIFY_API_KEY=

# --- Postmypost ---
POSTMYPOST_TOKEN=
POSTMYPOST_PROJECT_ID=

# --- Webhook-подпись (FIX-10: fail-open, если не задан) ---
FACTORY_WEBHOOK_SECRET=           # секрет подписи колбэков creatify (заголовок x-factory-secret)

# --- Мосты (db-bridge / hermes-bridge) ---
FACTORY_DB_BRIDGE_TOKEN=          # X-BRIDGE-TOKEN для http://db-bridge:8787/query (fail-closed при пустом)
HERMES_BRIDGE_TOKEN=              # X-BRIDGE-TOKEN для http://host.docker.internal:8642/ask
HERMES_BRIDGE_PORT=8642           # порт hermes-bridge (host, systemd hermes-bridge.service)

# --- LLM-провайдер (opencode zen → deepseek) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Hermes ---
HERMES_HOST=localhost
HERMES_PORT=8000
HERMES_API_KEY=

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=
N8N_API_KEY=
N8N_ENCRYPTION_KEY=

# --- Общее ---
FACTORY_DB_PATH=/var/data/factory.db
MEDIA_DIR=/var/media
TZ=Europe/Moscow

# --- Бюджетные лимиты ---
CREATIFY_DAILY_VIDEO_LIMIT=3
CREATIFY_MONTHLY_VIDEO_LIMIT=100
CREATIFY_CREDIT_FLOOR=50

# --- Дашборд (P2) ---
DASHBOARD_PASSWORD=
