        "language": "javaScript",
        "jsCode": "const wh = $('Webhook').first().json.body;\nconst pub = $json;\nlet caption = '';\nif (wh.captions) {\n  caption = typeof wh.captions === 'string' ? wh.captions : (wh.captions.instagram ? wh.captions.instagram : JSON.stringify(wh.captions));\n}\nconst sql = \"INSERT INTO posts (client_id, generation_id, cycle_date, caption, target_platforms, postmypost_id, post_at, status) VALUES (1, ?, date('now'), ?, ?, ?, ?, 'pending_publication')\";\nconst params = [wh.generation_id, caption, JSON.stringify(wh.platforms || []), pub.id, wh.post_at];\nreturn [{ json: { sql: sql, params: params } }];"
