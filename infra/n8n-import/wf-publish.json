      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const wh = $('Webhook').first().json.body;\nconst fileId = $json.file_id !== undefined ? $json.file_id : null;\nconst platforms = Array.isArray(wh.platforms) ? wh.platforms : [];\nconst captions = wh.captions || {};\nconst accountMap = { instagram: 101, youtube: 102, tiktok: 103, threads: 104, x: 105, telegram: 106 };\nconst details = [];\nconst accountIds = [];\nfor (const p of platforms) {\n  const aid = accountMap[p];\n  if (!aid) continue;\n  accountIds.push(aid);\n  const caption = (captions[p] !== undefined) ? captions[p] : (typeof captions === 'string' ? captions : '');\n  if (p === 'instagram') {\n    details.push({ account_id: aid, publication_type: 4, content: caption, file_ids: [fileId], instagram_share_to_feed: true });\n  } else if (p === 'youtube') {\n    details.push({ account_id: aid, publication_type: 4, content: caption, title: caption, file_ids: [fileId], youtube_privacy_status: 1 });\n  } else if (p === 'tiktok') {\n    details.push({ account_id: aid, publication_type: 1, content: caption, file_ids: [fileId] });\n  } else if (p === 'threads') {\n    details.push({ account_id: aid, publication_type: 1, content: caption });\n  } else if (p === 'x') {\n    details.push({ account_id: aid, publication_type: 1, content: caption });\n  } else if (p === 'telegram') {\n    details.push({ account_id: aid, publication_type: 1, content: caption });\n  }\n}\nconst captionOut = (typeof captions === 'object' && captions.instagram) ? captions.instagram : captions;\nreturn [{ json: { details: details, account_ids: accountIds, file_id: fileId, post_at: wh.post_at, caption: captionOut, platforms: platforms, generation_id: wh.generation_id } }];"
      },
