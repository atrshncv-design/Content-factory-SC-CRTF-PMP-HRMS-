        "jsCode": "const v = $('Validate').first().json;\nconst linkId = ($json.link_id && String($json.link_id).trim()) || v.link;\nconst body = { link: linkId, video_url: v.source_video_url, aspect_ratio: v.aspect_ratio };\nif (v.language) body.language = v.language;\nif (v.webhook_url) body.webhook_url = v.webhook_url;\nreturn [{ json: { body: body } }];"
      },
