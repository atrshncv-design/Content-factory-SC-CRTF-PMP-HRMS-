        "language": "javaScript",
        "jsCode": "const d = ($json && typeof $json === 'object') ? $json : {};\n// ВАЖНО (проверено 13.08, CR-4): сущность Link у Creatify = ВЕРХНИЙ id ответа\n// POST /api/links/ ({id: <link-id>, link: {...}}). Вложенный link.id невалиден:\n// GET /api/links/<вложенный>/ -> 404, POST /api/ads_clone/ с ним -> 400 \"Invalid link ID\".\nconst linkId = d.id || (d.link && d.link.id) || null;\nreturn [{ json: { link_id: linkId } }];"
      },
