    "id": "99999999-1111-2222-3333-444444444452",
    "name": "HTTP GET creatify",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.5,
    "position": [
     40,
     120
    ]
   },
   {
    "parameters": {
     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "// Обработка ответа GET /api/link_to_videos/?ids=...\n// creatify_id берём из SELECT (HTTP db-bridge), НЕ из ответа creatify.\nconst rows = ($('HTTP db-bridge').first().json.rows) || [];\nif (!rows.length) return [];\n\nconst resp = $json; // ответ GET: объект или массив, структура НЕ верифицирована\n\n// Дефенсивный сбор записей со статусом: items[].status / tasks[].status /\n// data[].status / status на верхнем уровне — ищем в любом вложении.\nconst records = [];\nconst seen = new Set();\n(function walk(node) {\n  if (!node || typeof node !== 'object') return;\n  if (Array.isArray(node)) { for (const el of node) walk(el); return; }\n  if (typeof node.status === 'string' && !seen.has(node)) {\n    seen.add(node);\n    records.push(node);\n  }\n  for (const k of Object.keys(node)) {\n    const v = node[k];\n    if (v && typeof v === 'object') walk(v);\n  }\n})(resp);\n\nfunction vid(rec) {\n  if (!rec || typeof rec !== 'object') return null;\n  for (const k of ['video_output_url', 'video_output', 'video_url', 'output_video', 'output_url', 'download_url', 'result_url']) {\n    if (typeof rec[k] === 'string' && rec[k]) return rec[k];\n  }\n  const arr = rec.videos || rec.video_urls;\n  if (Array.isArray(arr) && arr.length) {\n    const f = arr[0];\n    if (typeof f === 'string') return f;\n    if (f && typeof f.url === 'string') return f.url;\n  }\n  if (rec.result && typeof rec.result.url === 'string') return rec.result.url;\n  return null;\n}\n\nconst SQL_UPD = \"UPDATE generations SET status=?, video_output_url=?, updated_at=datetime('now') WHERE creatify_id=?\";\nconst out = [];\nfor (const row of rows) {\n  const cid = (row && row.creatify_id != null) ? String(row.creatify_id) : null;\n  if (!cid) continue;\n  const rec = records.find(r => String(r.id ?? r.creatify_id ?? r.job_id ?? r.task_id) === cid);\n  if (!rec) continue; // записи в ответе нет — не трогаем, след. цикл опросит снова\n  const st = String(rec.status).toLowerCase();\n  if (st === 'done') {\n    out.push({ json: { sql: SQL_UPD, params: [st, vid(rec), cid], creatify_id: cid, status: st } });\n  } else if (st === 'failed' || st === 'error') {\n    out.push({ json: { sql: SQL_UPD, params: ['failed', null, cid], creatify_id: cid, status: 'failed' } });\n  }\n  // in_queue / running / processing / pending / queued / started — без UPDATE\n}\nreturn out;"
    },
