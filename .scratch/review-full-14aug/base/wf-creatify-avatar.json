     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "const b = ($json.body && $json.body) || $json;\nconst video_url = String(b.video_url || '').trim();\nconst creator_name = String(b.creator_name || '').trim();\nconst gender = String(b.gender || '').trim();\nconst client_id = b.client_id || 1;\nif (!/^https?:\\/\\/.+/i.test(video_url)) {\n  return [{ json: { valid: false, error: 'video_url обязателен и должен быть http(s) URL' } }];\n}\nif (!creator_name) {\n  return [{ json: { valid: false, error: 'creator_name обязателен' } }];\n}\nif (!['m', 'f', 'nb'].includes(gender)) {\n  return [{ json: { valid: false, error: 'gender должен быть m | f | nb' } }];\n}\nreturn [{ json: { valid: true, video_url, creator_name, gender, client_id, video_scene: b.video_scene || 'office' } }];"
    },
