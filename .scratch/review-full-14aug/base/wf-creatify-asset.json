     "jsCode": "const body = ($json.body && $json.body) || $json;\nconst prompt = (body.prompt !== undefined && body.prompt !== null) ? String(body.prompt).trim() : '';\nconst type = (body.type !== undefined && body.type !== null && String(body.type).trim() !== '') ? String(body.type).trim() : 'flux-pro/kontext/text-to-image';\nlet count = (body.count !== undefined && body.count !== null && body.count !== '') ? Number(body.count) : 1;\nif (!Number.isFinite(count) || count < 1) count = 1;\ncount = Math.min(4, Math.floor(count));\nif (prompt === '') {\n  return [{ json: { ok: false, error: 'prompt обязателен' } }];\n}\nreturn [{ json: { ok: true, payload: { model_name: type, input_params: { prompt: prompt, num_images: count } } } }];"
