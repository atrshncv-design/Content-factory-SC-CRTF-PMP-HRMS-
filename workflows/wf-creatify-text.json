     "jsCode": "const raw = ($json.body && typeof $json.body === 'object') ? $json.body : ($json || {});\nconst topic = String(raw.topic || '').trim();\nconst valid = topic ? 1 : 0;\nconst video_length = [15, 30, 45, 60].includes(Number(raw.video_length)) ? Number(raw.video_length) : 30;\nconst language = String(raw.language || 'ru').trim() || 'ru';\nconst description = String(raw.description || topic || '').trim();\nconst target_audience = raw.target_audience != null ? String(raw.target_audience).trim() : '';\nreturn [{ json: { valid, topic, description, language, target_audience, video_length, title: topic } }];"
    },
