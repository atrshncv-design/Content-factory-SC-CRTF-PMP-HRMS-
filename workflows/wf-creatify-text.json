     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "const r = ($json && typeof $json === 'object' && !Array.isArray($json)) ? $json : {};\nconst body = (r.body && typeof r.body === 'object' && !Array.isArray(r.body)) ? r.body : r;\nconst err = (typeof body.error === 'string' && body.error) ? body.error\n  : (typeof body.detail === 'string' && body.detail) ? body.detail\n  : (typeof body.message === 'string' && body.message) ? body.message : null;\nif (!body.id || err) {\n  return [{ json: { ok: 0, error: err || 'invalid_response_no_id', script_id: '', status: 'error', text: '', script_name: null, script_style: null, scripts_count: 0, credits_used: null, failed_reason: err || null, raw: r } }];\n}\nconst list = Array.isArray(body.generated_scripts) ? body.generated_scripts : [];\nconst first = list[0] || {};\nconst text = String(first.paragraphs || '');\nconst done = body.status === 'done' && text.length > 0;\nreturn [{ json: { ok: done ? 1 : 0, script_id: String(body.id || ''), status: String(body.status || 'unknown'), text: text, script_name: first.script_name || null, script_style: first.script_style || null, scripts_count: list.length, credits_used: body.credits_used != null ? Number(body.credits_used) : null, failed_reason: body.failed_reason || null, error: done ? null : 'generation_not_ready' } }];"
    },
