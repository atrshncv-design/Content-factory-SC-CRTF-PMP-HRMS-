    {
      "id": "6c000001-0000-4000-8000-00000000000a",
      "name": "Build payload video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 160],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $json;\nconst p = {};\nif (d.motion_style) p.motion_style = d.motion_style;\nif (d.video_prompt) p.video_prompt = d.video_prompt;\nif (d.webhook_url) p.webhook_url = d.webhook_url;\nconst id = d.product_video_id;\nreturn [{ json: { id: id, url: 'https://api.creatify.ai/api/product_to_videos/' + id + '/gen_video/', payload: p, meta: { target_audience: d.target_audience, language: d.language } } }];"
