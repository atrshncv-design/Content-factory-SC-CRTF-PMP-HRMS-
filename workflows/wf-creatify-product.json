      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $json;\nreturn [{\n  json: {\n    ok: true,\n    product_video_id: r.id || null,\n    status: r.status || null,\n    generated_photo_url: r.generated_photo_url || null,\n    failed_reason: r.failed_reason || null,\n    credits_used: r.credits_used || 0,\n    raw: r\n  }\n}];"
      }
    },
    {
      "id": "6c000001-0000-4000-8000-000000000009",
      "name": "Respond ok image",
      "type": "n8n-nodes-base.respondToWebhook",
