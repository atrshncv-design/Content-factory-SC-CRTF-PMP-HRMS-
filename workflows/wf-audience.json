      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const wb = $('audience-webhook').first().json;\nconst b = (wb && wb.body) || wb || {};\nconst platform = b.platform || wb.platform || null;\nconst handle = b.handle || wb.handle || null;\nconst raw = $json;\n\nconst pct = (s) => {\n  const n = parseFloat(String(s == null ? '' : s).replace('%', ''));\n  return Number.isFinite(n) ? n : 0;\n};\n\nif (!raw || raw.success === false) {\n  return [{ json: { ok: false, error: 'api_error', message: (raw && raw.message) || 'scrapecreators API error' } }];\n}\n\nconst top_countries = Array.isArray(raw.audienceLocations)\n  ? raw.audienceLocations.map((l) => ({ country: l.country, percent: pct(l.percentage) }))\n  : [];\n\nreturn [{\n  json: {\n    ok: true,\n    audience: {\n      platform: platform,\n      handle: handle,\n      gender: [],\n      age_ranges: [],\n      top_countries: top_countries\n    }\n  }\n}];"
      },
