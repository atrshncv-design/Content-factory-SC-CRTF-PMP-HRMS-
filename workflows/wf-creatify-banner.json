     "jsCode": "// CR-7: валидация webhook factory/banner -> payload POST /api/iab_images/\n// Контракт: {image_url, sizes?, webhook_url?} (image_url = алиас image).\nconst base = ($json && typeof $json === 'object' && !Array.isArray($json)) ? $json : {};\nconst body = (base.body && typeof base.body === 'object' && !Array.isArray(base.body)) ? base.body : {};\nconst img = body.image_url || body.image || null;\nif (!img || typeof img !== 'string' || !img.trim()) {\n  return [{ json: { ok: false, error: 'image_url обязателен (изображение для IAB-баннеров)' } }];\n}\nif (!/^https?:\\/\\//i.test(img.trim())) {\n  return [{ json: { ok: false, error: 'image_url должен быть http(s) URL' } }];\n}\nconst payload = { image: img.trim() };\nif (body.webhook_url && typeof body.webhook_url === 'string') {\n  payload.webhook_url = body.webhook_url;\n}\nreturn [{ json: { ok: true, payload, sizes: body.sizes || null, raw: body } }];"
    },
