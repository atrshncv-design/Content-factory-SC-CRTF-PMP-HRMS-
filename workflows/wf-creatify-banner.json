     "jsCode": "const r = ($json && typeof $json === 'object' && !Array.isArray($json)) ? $json : {};\nconst body = (r.body && typeof r.body === 'object' && !Array.isArray(r.body)) ? r.body : r;\nconst err = (typeof body.error === 'string' && body.error) ? body.error\n  : (typeof body.detail === 'string' && body.detail) ? body.detail\n  : (typeof body.message === 'string' && body.message) ? body.message : null;\nif (!body.id || err) {\n  return [{ json: { ok: false, error: err || 'invalid_response_no_id', raw: r } }];\n}\nconst urls = Array.isArray(body.output) ? body.output.map((o) => ({\n  name: o.name || null,\n  size: o.size || null,\n  type: o.type || null,\n  url: o.url || null\n})) : [];\nreturn [{\n  json: {\n    ok: true,\n    banner_id: body.id || null,\n    status: body.status || null,\n    urls,\n    credits_used: (body.credits_used !== undefined && body.credits_used !== null) ? body.credits_used : null,\n    failed_reason: body.failed_reason || null,\n    raw: body\n  }\n}];"
