     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "// CR-7: валидация webhook factory/inspiration -> payload POST /api/inspiration_jobs/\n// Контракт: {inspiration_id (алиас template_id), input_params?, source_url?, webhook_url?}\nconst base = ($json && typeof $json === 'object' && !Array.isArray($json)) ? $json : {};\nconst body = (base.body && typeof base.body === 'object' && !Array.isArray(base.body)) ? base.body : {};\nconst inspId = body.inspiration_id || body.template_id || null;\nif (!inspId || typeof inspId !== 'string' || !inspId.trim()) {\n  return [{ json: { ok: false, error: 'inspiration_id (или template_id) обязателен' } }];\n}\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(inspId.trim())) {\n  return [{ json: { ok: false, error: 'inspiration_id должен быть UUID' } }];\n}\nlet inputParams = body.input_params;\nif (!inputParams || typeof inputParams !== 'object' || Array.isArray(inputParams)) {\n  if (body.source_url && typeof body.source_url === 'string') {\n    inputParams = { source_url: body.source_url };\n  } else {\n    return [{ json: { ok: false, error: 'input_params (объект) обязателен (или source_url)' } }];\n  }\n}\nconst payload = { inspiration_id: inspId.trim(), input_params: inputParams };\nif (body.webhook_url && typeof body.webhook_url === 'string') {\n  payload.webhook_url = body.webhook_url;\n}\nreturn [{ json: { ok: true, payload, raw: body } }];"
    },
