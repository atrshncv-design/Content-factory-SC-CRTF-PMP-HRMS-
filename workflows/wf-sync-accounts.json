    },
    "id": "51e00000-0000-4000-8000-000000000106",
    "name": "Split In Batches",
    "type": "n8n-nodes-base.splitInBatches",
    "typeVersion": 3,
    "position": [
     100,
     0
    ]
   },
   {
    "parameters": {
     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "const items = $input.all();\nconst sql = \"INSERT INTO social_accounts (id, name, platform, login, connection_status, synced_at) VALUES (?, ?, ?, ?, ?, datetime('now')) ON CONFLICT(id) DO UPDATE SET name=excluded.name, platform=excluded.platform, login=excluded.login, connection_status=excluded.connection_status, synced_at=datetime('now')\";\nconst out = [];\nfor (const it of items) {\n  const j = it.json;\n  out.push({ json: {\n    sql: sql,\n    params: [Number(j.id), String(j.name), String(j.platform), String(j.login), Number(j.connection_status)],\n    name: String(j.name),\n    connection_status: Number(j.connection_status)\n  }});\n}\nreturn out;"
    },
