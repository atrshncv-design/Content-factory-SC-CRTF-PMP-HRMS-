   },
   {
    "parameters": {
     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "// Mock-снимок аккаунтов postmypost — повторяет состояние БД на 13.08: 5 аккаунтов\n// (IG=101, YT=102, Threads=104, X=105, TikTok=106).\n// VK ОТСУТСТВУЕТ (G01): аккаунты подключает пользователь перед платными тестами;\n// после подключения VK появится в этом синке через real-ветку GET /v4.1/accounts.\nreturn [\n  { json: { id: 101, name: 'Robotec Instagram', platform: 'instagram', login: 'robotec_ru', connection_status: 1 } },\n  { json: { id: 102, name: 'Robotec YouTube', platform: 'youtube', login: 'robotec', connection_status: 1 } },\n  { json: { id: 104, name: 'Robotec Threads', platform: 'threads', login: 'robotec', connection_status: 1 } },\n  { json: { id: 105, name: 'Robotec X', platform: 'x', login: 'robotec', connection_status: 1 } },\n  { json: { id: 106, name: 'Robotec TikTok', platform: 'tiktok', login: 'robotec', connection_status: 2 } }\n];"
    },
    "id": "51e00000-0000-4000-8000-000000000103",
    "name": "Code mock accounts",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     -280,
     -120
    ]
   },
   {
    "parameters": {
     "method": "GET",
     "url": "https://api.postmypost.io/v4.1/accounts",
     "authentication": "genericCredentialType",
     "genericAuthType": "httpBearerAuth",
     "sendQuery": true,
     "queryParameters": {
      "parameters": [
       {
        "name": "project_id",
        "value": "={{ $env.POSTMYPOST_PROJECT_ID }}"
       }
      ]
     },
     "options": {}
    },
    "id": "51e00000-0000-4000-8000-000000000104",
    "name": "HTTP real",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.5,
    "position": [
     -280,
     120
    ],
    "credentials": {
     "httpBearerAuth": {
      "id": "10000000-0000-4000-8000-000000000003",
      "name": "postmypost"
     }
    }
   },
   {
    "parameters": {
     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "const items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const raw = it.json;\n  let arr;\n  if (Array.isArray(raw)) arr = raw;\n  else if (Array.isArray(raw.accounts)) arr = raw.accounts;\n  else if (Array.isArray(raw.data)) arr = raw.data;\n  else if (raw.data && Array.isArray(raw.data.accounts)) arr = raw.data.accounts;\n  else arr = [raw];\n  for (const a of arr) {\n    if (!a || a.id === undefined || a.id === null) continue;\n    out.push({ json: {\n      id: Number(a.id),\n      name: String(a.name || ''),\n      platform: String(a.platform || ''),\n      login: String(a.login || ''),\n      connection_status: a.connection_status === undefined ? 1 : Number(a.connection_status)\n    }});\n  }\n}\nreturn out;"
    },
    "id": "51e00000-0000-4000-8000-000000000105",
    "name": "Code normalize",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     -80,
