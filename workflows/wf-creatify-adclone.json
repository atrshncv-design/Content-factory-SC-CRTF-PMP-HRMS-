   {
    "parameters": {
     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "const raw = ($json.body && typeof $json.body === 'object') ? $json.body : ($json || {});\nconst source_video_url = String(raw.source_video_url || '').trim();\nconst link = String(raw.link || '').trim();\nconst aspect_ratio = String(raw.aspect_ratio || '9x16').trim();\nconst language = String(raw.language || '').trim() || null;\nconst webhook_url = String(raw.webhook_url || '').trim() || '';\nlet brandUrl = 'https://robotec.ru';\nconst ba = raw.brand_assets;\nif (typeof ba === 'string' && /^https?:\\/\\//.test(ba.trim())) brandUrl = ba.trim();\nelse if (ba && typeof ba === 'object' && typeof ba.url === 'string' && /^https?:\\/\\//.test(ba.url.trim())) brandUrl = ba.url.trim();\nif (!/^https?:\\/\\/.+/.test(source_video_url)) {\n  return [{ json: { valid: 0, error: 'source_video_url обязателен и должен быть http(s) URL' } }];\n}\nif (!['9x16', '16x9', '1x1'].includes(aspect_ratio)) {\n  return [{ json: { valid: 0, error: 'aspect_ratio должен быть 9x16 | 16x9 | 1x1' } }];\n}\nif (link && !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(link)) {\n  return [{ json: { valid: 0, error: 'link должен быть UUID' } }];\n}\nreturn [{ json: { valid: 1, source_video_url: source_video_url, link: link, aspect_ratio: aspect_ratio, language: language, webhook_url: webhook_url, brandUrl: brandUrl } }];"
    },
