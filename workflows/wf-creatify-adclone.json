     "jsCode": "const r = ($json && typeof $json === 'object' && !Array.isArray($json)) ? $json : {};\nconst body = (r.body && typeof r.body === 'object' && !Array.isArray(r.body)) ? r.body : r;\nconst err = (typeof body.error === 'string' && body.error) ? body.error\n  : (typeof body.detail === 'string' && body.detail) ? body.detail\n  : (typeof body.message === 'string' && body.message) ? body.message : null;\nif (!body.id || err) {\n  return [{ json: { ok: false, error: err || 'invalid_response_no_id', raw: r } }];\n}\nreturn [{ json: {\n  ok: true,\n  ad_clone_id: body.id || null,\n  status: body.status || 'unknown',\n  credits_used: (typeof body.credits_used === 'number') ? body.credits_used : null,\n  video_output: body.video_output || null,\n  media_job: body.media_job || null,\n  link: body.link || null,\n  cost_warning: 'ad_clone стоит ~84 кредита'\n} }];"
