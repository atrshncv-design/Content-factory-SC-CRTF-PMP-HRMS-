  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "const input = $input.all()[0] ? $input.all()[0].json : {};\nconst items = (input && Array.isArray(input.profiles)) ? input.profiles : [];\nconst out = [];\nfor (const p of items) {\n  if (!p) continue;\n  out.push({ json: {\n    handle: String(p.username || ''),\n    platform: 'instagram',\n    followers: Number(p.follower_count) || 0,\n    nickname: String(p.full_name || p.username || ''),\n    bio: String(p.biography || ''),\n    category: p.category_name || null,\n    avatar_url: String(p.profile_pic_url || ''),\n    profile_url: String(p.url || '')\n  }});\n}\nreturn out;"
   },
