     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "\nconst creators = $('Code Top-N').all().map((i) => i.json).filter((c) => c && c.handle);\nconst cid = ($json.rows && $json.rows[0]) ? $json.rows[0].cid : null;\nif (!cid || creators.length === 0) {\n  return [{ json: { sql: 'SELECT 1', params: [] } }];\n}\nconst placeholders = creators.map(() => '(?, ?, ?, ?, 0)').join(', ');\nconst params = [];\nfor (const c of creators) {\n  params.push(cid, String(c.handle), String(c.platform), JSON.stringify(c));\n}\nconst sql = 'INSERT OR IGNORE INTO competitors (client_id, handle, platform, profile_data, is_seed) VALUES ' + placeholders;\nreturn [{ json: { sql: sql, params: params } }];\n"
    },
