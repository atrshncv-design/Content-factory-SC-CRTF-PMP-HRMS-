  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "const input = $input.all()[0] ? $input.all()[0].json : {};\nconst items = (input && Array.isArray(input.users)) ? input.users : [];\nconst out = [];\nfor (const t of items) {\n  if (!t) continue;\n  const av = (t.avatar_medium && Array.isArray(t.avatar_medium.url_list) && t.avatar_medium.url_list.length)\n    ? t.avatar_medium.url_list[0] : '';\n  out.push({ json: {\n    handle: String(t.unique_id || ''),\n    platform: 'tiktok',\n    followers: Number(t.follower_count) || 0,\n    nickname: String(t.nickname || t.unique_id || ''),\n    bio: '',\n    category: null,\n    avatar_url: av,\n    profile_url: t.unique_id ? 'https://www.tiktok.com/@' + t.unique_id : ''\n  }});\n}\nreturn out;"
   },
