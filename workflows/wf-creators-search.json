   {
    "parameters": {
     "mode": "runOnceForAllItems",
     "language": "javaScript",
     "jsCode": "\nconst items = ($input.all() || []).map((i) => i.json);\nconst errors = items.filter((c) => c && c.ok === false);\nif (errors.length > 0) return errors.map((e) => ({ json: e }));\nconst creators = items.filter((c) => c && c.handle);\nconst seen = new Set();\nconst pool = [];\nfor (const c of creators) {\n  const key = String(c.handle).toLowerCase() + '|' + String(c.platform || '').toLowerCase();\n  if (seen.has(key)) continue;\n  seen.add(key);\n  pool.push(c);\n}\npool.sort((a, b) => (Number(b.followers) || 0) - (Number(a.followers) || 0));\nreturn pool.slice(0, 10).map((c) => ({ json: c }));\n"
    },
