     "jsCode": "// GET /v1/account/credit-balance -> {creditCount: N} (бесплатный, 0 кредитов).\n// Универсальный парсер: body(объект) -> raw -> JSON.parse(data); creditCount в разных местах.\n// balance_unavailable (401/502/сеть/не-JSON) -> гейт ПРОПУСКАЕТ платную ветку (не блокирует цепочку).\nconst raw = ($json && typeof $json === 'object' && !Array.isArray($json)) ? $json : {};\nconst src = (() => { try { return $('Code validate').first().json; } catch (e) { return {}; } })();\nconst pass = (src && typeof src === 'object' && !Array.isArray(src)) ? src : {};\nconst body = (raw.body && typeof raw.body === 'object' && !Array.isArray(raw.body)) ? raw.body : null;\nlet balance = null;\ntry {\n  if (body && body.creditCount != null) {\n    balance = Number(body.creditCount);\n  } else if (raw.creditCount != null) {\n    balance = Number(raw.creditCount);\n  } else if (typeof raw.data === 'string') {\n    balance = Number(JSON.parse(raw.data).creditCount);\n  }\n} catch (err) {\n  balance = null;\n}\nif (balance == null || !Number.isFinite(balance)) {\n  return [{ json: Object.assign({}, pass, { balance: -1, creditCount: -1, balance_unavailable: true }) }];\n}\nreturn [{ json: Object.assign({}, pass, { balance: balance, creditCount: balance, balance_unavailable: false }) }];"
    },
