  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "const items = ($input.all() || []).map((i) => i.json).filter((c) => c && c.handle);\nconst seen = new Set();\nconst pool = [];\nfor (const c of items) {\n  const key = String(c.handle).toLowerCase() + '|' + String(c.platform || '').toLowerCase();\n  if (!c.handle || seen.has(key)) continue;\n  seen.add(key);\n  pool.push(c);\n}\npool.sort((a, b) => (Number(b.followers) || 0) - (Number(a.followers) || 0));\nreturn pool.slice(0, 10).map((c) => ({ json: c }));"
   },
