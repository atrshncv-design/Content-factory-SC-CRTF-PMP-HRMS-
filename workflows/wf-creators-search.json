  {
   "parameters": {
    "mode": "runOnceForAllItems",
    "language": "javaScript",
    "jsCode": "const input = $input.all()[0] ? $input.all()[0].json : {};\nconst items = (input && Array.isArray(input.channels)) ? input.channels : [];\nconst out = [];\nfor (const c of items) {\n  if (!c) continue;\n  out.push({ json: {\n    handle: String(c.handle || ''),\n    platform: 'youtube',\n    followers: Number(c.subscriberCountInt) || 0,\n    nickname: String(c.channelName || c.handle || ''),\n    bio: String(c.description || ''),\n    category: null,\n    avatar_url: String(c.thumbnail || ''),\n    profile_url: c.id ? 'https://www.youtube.com/channel/' + c.id : ''\n  }});\n}\nreturn out;"
   },
   "id": "97328cf2-a8c5-448b-bef2-a6cde1357f30",
   "name": "Normalize YouTube",
   "type": "n8n-nodes-base.code",
